# Lo más fácil es crear este archivo con configurar.bat.
# Si lo hacés a mano: copiá este archivo como ".env" y completá los datos.

# Datos de tu aplicación en developers.mercadolibre.com.ar
ML_CLIENT_ID=1234567890123456
ML_CLIENT_SECRET=tu_clave_secreta

# Tu dominio gratis de ngrok, con https:// y sin barra al final
BASE_URL=https://tu-nombre.ngrok-free.app

# Contraseña para entrar al panel y al escáner
ADMIN_PASSWORD=elegi-una-contraseña-larga

# ---- Solo para pasar los datos de esta PC a Vercel (node migrar.js) ----
# Copialas de Vercel → Storage → (tu base Upstash / tu Blob store) → pestaña ".env.local"
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=xxxx
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxx
